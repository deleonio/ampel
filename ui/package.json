{
  "name": "ampel-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "react-router dev",
    "test-dev": "cross-env VITE_TEST_DATA_VIEW=test react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "npx eslint --fix",
    "format": "npx prettier --write ..",
    "prepare": "husky || true",
    "test": "vitest",
    "coverage": "vitest run --coverage && node scripts/generate-ci-bericht.mjs --coverage-summary",
    "clean": "rm -rf node_modules",
    "reinstall": "npm run clean && npm install",
    "rebuild": "npm run clean && npm install && npm run build",
    "release:lint": "eslint .. --ext .ts,.tsx --max-warnings 0 --cache --cache-location .eslintcache",
    "eslint:check": "eslint .. --ext .ts,.tsx --max-warnings 0 --no-cache",
    "bericht:ci": "node scripts/generate-ci-bericht.mjs",
    "format:check": "prettier .. --check",
    "format:write": "prettier .. --write",
    "demo-dev": "cross-env VITE_TEST_DATA_VIEW=demo react-router dev",
    "demo-build:web": "cross-env VITE_TEST_DATA_VIEW=demo react-router build",
    "demo-build": "npm run demo-build:web && node scripts/build-desktop-package.mjs",
    "desktop:dev": "concurrently -k \"cross-env VITE_TEST_DATA_VIEW=demo react-router dev --host 127.0.0.1 --port 5173\" \"wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "desktop:build": "npm run demo-build",
    "a11y": "npm run build && node a11y/axe.mjs"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.ampel.ui",
    "productName": "AMPEL UI RELEASE",
    "artifactName": "AMPEL UI RELEASE.${ext}",
    "asar": false,
    "files": [
      "electron/**/*",
      "assets/favicon.ico",
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/favicon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    }
  },
  "overrides": {
    "@electron/asar": "^4.2.0",
    "@electron/get": "^5.0.0",
    "@electron/universal": "^3.0.4"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@public-ui/components": "5.0.0-beta.3",
    "@public-ui/react-v19": "5.0.0-beta.3",
    "@public-ui/theme-default": "5.0.0-beta.3",
    "@react-router/node": "^7.10.1",
    "@react-router/serve": "^7.10.1",
    "@tailwindcss/postcss": "^4.1.17",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-is": "^19.2.1",
    "react-router": "^7.10.1",
    "recharts": "^3.5.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@react-router/dev": "^7.10.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "@vitest/coverage-v8": "4.0.15",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "eslint-plugin-unused-imports": "4.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "playwright": "1.65.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.49.0",
    "vite": "^7.3.3",
    "vitest": "^4.0.15",
    "wait-on": "^8.0.3"
  }
}
